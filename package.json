{
  "name": "langs-es",
  "version": "4.1.0",
  "description": "ISO 639-1/2/3 Language codes with English and local names",
  "keywords": [
    "639",
    "639-1",
    "639-2",
    "639-3",
    "iso",
    "iso639",
    "lang",
    "langs",
    "language",
    "languages",
    "es",
    "esm",
    "ts"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "files": [
    "dist",
    "NOTICE",
    "util/postinstall.js"
  ],
  "scripts": {
    "prepare": "node util/prepare.js",
    "test": "mocha test/cjs test/esm",
    "test-cjs": "mocha test/cjs",
    "generate": "node generator/generate.js",
    "build": "unbuild",
    "lint": "eslint . --ext js,cjs,mjs,ts,md --max-warnings=0"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:zxanderh/langs-es.git"
  },
  "unbuild": {
    "declaration": true
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@types/lodash-es": "^4.17.12",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "chai": "^6.2.2",
    "eslint": "^10.4.1",
    "eslint-plugin-markdownlint": "^0.10.1",
    "eslint-plugin-mocha": "^11.3.0",
    "globals": "^17.6.0",
    "got": "^15.0.5",
    "lodash-es": "^4.18.1",
    "markdownlint-cli": "^0.48.0",
    "mocha": "^11.7.6",
    "neat-csv": "^7.0.0",
    "typescript": "^5.x",
    "unbuild": "^3.6.1"
  },
  "allowScripts": {
    "esbuild": true,
    "langs-es": true
  }
}
